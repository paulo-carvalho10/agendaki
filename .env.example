# Somente no servidor. Nunca usar NEXT_PUBLIC_ nestas variáveis.
DATABASE_URL=postgresql://usuario:senha@host/agendaki?sslmode=require
# Seed permitido somente em um banco dedicado à demonstração.
ALLOW_DEMO_SEED=false
DEMO_OWNER_PASSWORD=
# Na Vercel: conexão direta para as migrações (a integração do Neon cria as duas).
DATABASE_URL_UNPOOLED=
# Na Vercel: protege /api/reiniciar-demo, chamado uma vez por dia. Gere um valor aleatório longo.
CRON_SECRET=
# Avisos no celular do dono (Web Push). Gere o par com `pnpm avisos:chaves`.
# Sem estas três, o sistema funciona igual, só sem notificação.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelos serviços de push: o endereço https do site ou um mailto.
VAPID_SUBJECT=
# Opcional: WhatsApp do suporte (com DDD), mostrado na tela de entrada para quem esqueceu a senha.
SUPORTE_WHATSAPP=
# Opcional: endereço do site, usado por `pnpm negocio:link-senha` para montar o link.
SITE_URL=
